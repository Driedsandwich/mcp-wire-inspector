{
  "name": "mcp-wire-inspector",
  "version": "0.1.0",
  "description": "Dependency-free MCP transport recording and an optional DOM inspector.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:example": "vite build examples/browser",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20 <2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Driedsandwich/mcp-wire-inspector.git"
  }
}
